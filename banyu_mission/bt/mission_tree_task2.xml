<root BTCPP_format="4" main_tree_to_execute="BanyuMission">
  <BehaviorTree ID="BanyuMission">
    <ReactiveFallback name="Task2Supervisor">
      <AbortedOrTeleop name="IdleOrAborted" />
      <Sequence name="Task2MissionFlow">
        <MissionActive name="MissionRunning" />
        <SurfaceAcquireGpsAnchor name="SurfaceAcquireGpsAnchor" />
        <HomeToStartBuoy name="HomeToStartBuoy" />
        <IfThenElse name="Task2FollowSourceSelection">
          <Task2CameraSourceSelected name="Task2CameraSourceSelected" />
          <Sequence name="Task2CameraMissionFlow">
            <Task2CameraPreflight name="Task2CameraPreflight" />
            <AcquireTask2Pipeline name="AcquireTask2Pipeline" />
            <FollowAndRecordTask2Pipeline name="FollowAndRecordTask2Pipeline" />
            <ReverseToRedRing name="ReverseToRedRing" />
            <RepairRedRing name="RepairRedRing" />
            <SurfaceAtRedTarget name="SurfaceAtRedTarget" />
            <Task2Report name="Task2Report" />
          </Sequence>
          <Sequence name="Task2FixtureMissionFlow">
            <Task2Preflight name="Task2Preflight" />
            <FollowTask2Pipeline name="FollowTask2Pipeline" />
          </Sequence>
        </IfThenElse>
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>
</root>
