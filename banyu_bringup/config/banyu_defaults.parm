# BANYU curated ArduSub parameters shared by SITL and the real Pixhawk. Loaded into SITL by
# sitl_mavros.launch.py; on the robot load it once in QGroundControl (docs/por/README.md).
# Sim-only tuning lives in sim_only.parm and must never be loaded onto the robot. The VISO_* and EK3_SRC2_* lines
# are what nogps_odom_beacon needs (GPS-denied runs, sim and robot alike).
# BlueROV2 Heavy frame (vectored 6DOF: 8 thrusters).
FRAME_CONFIG 2

# RC channel map, same as the robot's Pixhawk and TX16S: right stick forward CH2 / lateral CH1,
# left stick throttle CH3 / yaw CH4; pitch and roll unmapped (0 = neutral dummy channel).
# SB (kill/arm) is CH6 and SC (flight mode) CH8, so no switch sits on a stick channel.
# Every por_params*.yaml rc_override.channel_* and banyu_teleop's stick channels follow this.
RCMAP_FORWARD 2
RCMAP_LATERAL 1
RCMAP_THROTTLE 3
RCMAP_YAW 4
RCMAP_PITCH 0
RCMAP_ROLL 0

# Mission speeds (m/s).
WP_SPD 1.0
WP_SPD_UP 2.5
WP_SPD_DN 1.5
# Hold current heading in GUIDED/AUTO unless explicitly commanded.
# Default (4 = CORRECT_XTRACK) computes bearing of a zero-length stopping-point
# vector on GUIDED entry, which slews yaw toward 0 deg NED (North = +90 deg ENU).
WP_YAW_BEHAVIOR 0

# Thruster output range: full 1100..1900 since the ESC power board upgrade (2026-11-13);
# at 50% the two vertical thrusters could barely dive. AP_Motors6DOF::calc_thrust_to_pwm maps every motor's thrust (-1..1) to
# 1500 +/- (PWM_MAX-1500 | 1500-PWM_MIN), so this range caps all motors in every
# mode: RC MANUAL, ALT_HOLD RC override (POR) and GUIDED velocity (Task 2).
# To cap again keep the range symmetric around 1500:
#   50% -> 1300 1700   60% -> 1260 1740   70% -> 1220 1780
# QGC Motor Test writes raw PWM and bypasses this range.
# tools/scripts/check/check_thrust_limit.py verifies the Pixhawk against these lines.
MOT_PWM_MIN 1100
MOT_PWM_MAX 1900

# Manual/teleop speeds (cm/s).
PILOT_SPEED 200
PILOT_SPEED_UP 100
PILOT_SPEED_DN 0

# EKF failsafe: 0 = never failsafe (keep teleop control authority).
FS_EKF_ACTION 0

# GCS failsafe: 0 = Disabled.
# A tetherless AUV intentionally loses wireless/GCS link to dock when submerged.
# Mission abort and failure fallback (fallback_mode, Task 2: MANUAL) is managed onboard by banyu_mission.
FS_GCS_ENABLE 0

# RC failsafe: 1 = neutral sticks once no receiver frame arrives for RC_FS_TIMEOUT (1 s).
# With 0 ArduSub keeps the last stick values when the TX16S link drops, so a MANUAL drive
# keeps thrusting. Never 2 (SURFACE): the link is always lost under water, which would end
# every GUIDED dive. Does not block arming (AP_Arming::rc_arm_checks skips during failsafe);
# MAVROS RC override (POR ALT_HOLD) counts as RC input and clears it.
FS_THR_ENABLE 1

# GCS sysid allowed to send RC override / MANUAL_CONTROL. MAVROS uses system_id 255
# (mavros_config.yaml); any other value makes ArduSub ignore every POR stick command.
MAV_GCS_SYSID 255

# --- Navigation sources: GPS-denied (no GPS, no DVL) ---
# Names/values verified against libraries/AP_VisualOdom/AP_VisualOdom.cpp and
# libraries/AP_NavEKF/AP_NavEKF_Source.h.
#
# SRC1 is ArduPilot's shipped default (GPS position + velocity, baro height,
# compass yaw), used when the vehicle has GPS (Task 2 surface leg).
# SRC2 is the GPS-denied set: no horizontal position, baro depth, compass yaw.
# nogps_odom_beacon.py selects SRC2 (MAV_CMD_SET_EKF_SOURCE_SET) and streams a
# zero-delta VISION_POSITION_DELTA, which takes EKF3 to AID_RELATIVE via
#   VISION_POSITION_DELTA -> writeBodyFrameOdom() -> readyToUseBodyOdm()
# so /mavros/local_position/pose (depth + heading) is published without GPS.

VISO_TYPE 1             # 1 = MAVLink (0:None 2:IntelT265 3:VOXL)
# No physical sensor: the beacon's zero deltas describe the vehicle origin itself.
# A lever arm here would turn every yaw into a fake translation.
VISO_POS_X 0.0
VISO_POS_Y 0.0
VISO_POS_Z 0.0
VISO_ORIENT 0
VISO_DELAY_MS 10
VISO_VEL_M_NSE 0.1

# SRC2, written out in full: a source set is read as a unit.
# 6 = EXTNAV. readyToUseBodyOdm() returns false unless VELXY is EXTNAV or
# WHEEL_ENCODER, so this is what lets the beacon's body odometry aid the filter.
EK3_SRC2_VELXY 6
# 0 = NONE: no absolute horizontal position (GPS(3) would wait for a fix forever).
EK3_SRC2_POSXY 0
EK3_SRC2_POSZ 1         # baro depth
EK3_SRC2_VELZ 0
# Compass, NOT the SRC2 default of 0/NONE: with no yaw source EKF3 never
# completes yaw alignment and aiding is blocked outright.
EK3_SRC2_YAW 1
