        <geometry><cylinder><radius>0.03</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
