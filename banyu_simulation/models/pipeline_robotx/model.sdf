<?xml version="1.0"?>
<sdf version="1.11">
  <model name="pipeline_robotx">
    <static>true</static>
    <link name="body">
      <inertial auto="true" />
      <collision name="collision">
        <density>10.0</density>
        <geometry>
          <mesh optimization="convex_decomposition">
            <uri>model://pipeline_robotx/mesh.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://pipeline_robotx/mesh.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>