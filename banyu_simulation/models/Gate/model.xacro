<?xml version="1.0"?>
<robot name="gate" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gate Dimensions -->
  <!-- Width: 2m between post centers (Y scale 0.4) -->
  <!-- Depth: Top crossbar top surface placed 1m below water surface (z=0) -->
  <xacro:property name="scale_x" value="1.0" />
  <xacro:property name="scale_y" value="0.46" />
  <xacro:property name="scale_z" value="0.48" />

  <xacro:property name="orig_v_post_x" value="0.2" />
  <xacro:property name="orig_v_post_y" value="0.2" />
  <xacro:property name="orig_v_post_z" value="4.0" />

  <xacro:property name="orig_h_post_x" value="0.2" />
  <xacro:property name="orig_h_post_y" value="5.2" />
  <xacro:property name="orig_h_post_z" value="0.2" />

  <link name="link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <mass value="5000.0" />
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
    </inertial>

    <visual>
      <origin xyz="0 0 -3" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://banyu_simulation/models/Gate/meshes/gate.dae"
          scale="${scale_x} ${scale_y} ${scale_z}" />
      </geometry>
    </visual>

    <!-- Right Post Collision (-Y) -->
    <collision name="right_collision">
      <origin xyz="0 -1.15 -2.0" rpy="0 0 0" />
      <geometry>
        <box size="${orig_v_post_x*scale_x} ${orig_v_post_y*scale_y} ${orig_v_post_z*scale_z}" />
      </geometry>
    </collision>

    <!-- Left Post Collision (+Y) -->
    <collision name="left_collision">
      <origin xyz="0 1.15 -2.0" rpy="0 0 0" />
      <geometry>
        <box size="${orig_v_post_x*scale_x} ${orig_v_post_y*scale_y} ${orig_v_post_z*scale_z}" />
      </geometry>
    </collision>

    <!-- Top Crossbar Collision (top surface at -1.0m, depth 1m below surface z=0) -->
    <collision name="top_collision">
      <origin xyz="0 0 -1.05" rpy="0 0 0" />
      <geometry>
        <box size="${orig_h_post_x*scale_x} ${orig_h_post_y*scale_y} ${orig_h_post_z*scale_z}" />
      </geometry>
    </collision>
  </link>

  <gazebo reference="link">
    <visual>
      <material>
        <diffuse>1.0 1.0 1.0 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
        <!-- Matches yellow_buoy (diffuse 1 0.85 0 + emission 0.15 0.13 0). -->
        <emissive>0.15 0.13 0.0 1.0</emissive>
        <pbr>
          <metal>
            <albedo_map>model://banyu_simulation/models/Gate/materials/textures/gate.png</albedo_map>
            <!-- metalness=0: plain albedo (matte), avoids the dark full-metal look -->
            <metalness>0.0</metalness>
            <roughness>0.6</roughness>
          </metal>
        </pbr>
      </material>
    </visual>
  </gazebo>

  <gazebo>
    <static>true</static>
  </gazebo>
</robot>