<?xml version="1.0" encoding="UTF-8"?>
<!-- Task 2 gamble strategy (sensors:=gamble): GPS to the dive point (midpoint of the USV's two buoys by default, or the start buoy), a short timed dive and bobbing,
     then surface by GPS fix and report the buoy with a random light order. No camera, no pipe, no repair: heartbeat and start buoy
     points, the order by chance. Every underwater step is bounded by time; a failed step never stops the report. -->
<root BTCPP_format="4" main_tree_to_execute="Main">
  <BehaviorTree ID="Main">
    <ReactiveFallback name="mission_root">
      <Sequence name="interrupt_sequence">
        <AutonomyInterrupted />
        <HandleAbortOrTeleop />
      </Sequence>
      <Sequence name="mission_phases">
        <RequireMissionStarted />
        <RequireVehicleReady />
        <!-- No fallback to the configured coordinates: stand by on the surface until the USV's active buoy arrives. -->
        <WaitForBuoyTarget />
        <!-- Waited in standby_mode (MANUAL: floats, no hold pushing the hull under); now the surface mode (no-op if the same). -->
        <SetFcuMode mode="{surface_mode}" timeout_s="60" />
        <ForceSuccess>
          <Sequence name="surface_transit">
            <Timeout msec="180000">
              <RetryUntilSuccessful num_attempts="-1">
                <Fallback>
                  <NavigateSurfaceGps target_latitude="{target_latitude}" target_longitude="{target_longitude}"
                    start_latitude="{start_latitude}" start_longitude="{start_longitude}" tolerance="{gps_tolerance}" />
                  <Sequence>
                    <Sleep msec="1000" />
                    <AlwaysFailure />
                  </Sequence>
                </Fallback>
              </RetryUntilSuccessful>
            </Timeout>
            <LockBuoyTarget />
            <AlignHeading target_heading="{heading}" tolerance="{heading_tolerance}" />
          </Sequence>
        </ForceSuccess>
        <ForceSuccess>
          <Sequence name="short_dive_and_bobbing">
            <SetFcuMode mode="{underwater_mode}" />
          <TimedMove name="dive" segment_name="dive" duration_s="4.0" speed_x_mps="0.0" speed_y_mps="0.0" speed_z_mps="-0.05"
            yaw_rate_rad_s="0.0" use_baro_depth="false" target_depth_m="0.0" depth_kp="0.0" max_depth_speed_mps="0.0"
            use_imu_yaw_cap="false" target_yaw_delta_rad="0.0" />
          <TimedMove name="bob_up_1" segment_name="bob_up_1" duration_s="1.5" speed_x_mps="0.0" speed_y_mps="0.0" speed_z_mps="0.0"
            yaw_rate_rad_s="0.0" use_baro_depth="false" target_depth_m="0.0" depth_kp="0.0" max_depth_speed_mps="0.0"
            use_imu_yaw_cap="false" target_yaw_delta_rad="0.0" />
          <TimedMove name="bob_down_1" segment_name="bob_down_1" duration_s="1.0" speed_x_mps="0.0" speed_y_mps="0.0" speed_z_mps="-0.05"
            yaw_rate_rad_s="0.0" use_baro_depth="false" target_depth_m="0.0" depth_kp="0.0" max_depth_speed_mps="0.0"
            use_imu_yaw_cap="false" target_yaw_delta_rad="0.0" />
          <TimedMove name="bob_up_2" segment_name="bob_up_2" duration_s="1.5" speed_x_mps="0.0" speed_y_mps="0.0" speed_z_mps="0.0"
            yaw_rate_rad_s="0.0" use_baro_depth="false" target_depth_m="0.0" depth_kp="0.0" max_depth_speed_mps="0.0"
            use_imu_yaw_cap="false" target_yaw_delta_rad="0.0" />
          <TimedMove name="bob_down_2" segment_name="bob_down_2" duration_s="1.0" speed_x_mps="0.0" speed_y_mps="0.0" speed_z_mps="-0.05"
            yaw_rate_rad_s="0.0" use_baro_depth="false" target_depth_m="0.0" depth_kp="0.0" max_depth_speed_mps="0.0"
            use_imu_yaw_cap="false" target_yaw_delta_rad="0.0" />
          <TimedMove name="bob_up_3" segment_name="bob_up_3" duration_s="1.5" speed_x_mps="0.0" speed_y_mps="0.0" speed_z_mps="0.0"
            yaw_rate_rad_s="0.0" use_baro_depth="false" target_depth_m="0.0" depth_kp="0.0" max_depth_speed_mps="0.0"
            use_imu_yaw_cap="false" target_yaw_delta_rad="0.0" />
          <TimedMove name="bob_down_3" segment_name="bob_down_3" duration_s="1.0" speed_x_mps="0.0" speed_y_mps="0.0" speed_z_mps="-0.05"
            yaw_rate_rad_s="0.0" use_baro_depth="false" target_depth_m="0.0" depth_kp="0.0" max_depth_speed_mps="0.0"
            use_imu_yaw_cap="false" target_yaw_delta_rad="0.0" />
          </Sequence>
        </ForceSuccess>
        <GiveUpSurvey />
        <Surface target_depth="{surface_depth}" depth_tolerance="{surface_tolerance}" />
        <ConfirmSurfaceAction />
        <Timeout msec="15000">
          <PublishPipelineSurvey best_effort="true" />
        </Timeout>
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>
</root>
