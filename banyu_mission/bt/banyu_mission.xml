<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="Main">
  <BehaviorTree ID="Main">
    <ReactiveFallback name="mission_root">
      <Sequence name="interrupt_sequence">
        <AutonomyInterrupted />
        <HandleAbortOrTeleop />
      </Sequence>
      <Sequence name="mission_phases">
        <SubTree ID="MissionPreflight" _autoremap="true" />
        <!-- No ring is recorded until the survey pass (SurveyPipeline). -->
        <SetRingRecording enable="false" />
        <SubTree ID="SurfaceTransitToStart" _autoremap="true" />
        <!-- Always report: a pipe that is not found or a traverse that is lost still surfaces and sends the Core survey of
             what was seen (the heartbeat and start-buoy points are kept). -->
        <Fallback name="survey_or_report_what_was_seen">
          <Sequence>
            <SubTree ID="DiveAndAcquirePipeline" _autoremap="true" />
            <SubTree ID="SurveyPipeline" _autoremap="true" />
          </Sequence>
          <!-- Second try: surface, move retry_dive_offset_m along the buoy line toward the other buoy (the pipe lies
               between them), dive again. The ring order is by progress along the buoy line, from whichever point. -->
          <Sequence name="second_dive_along_the_buoy_line">
            <Surface target_depth="{surface_depth}" depth_tolerance="{surface_tolerance}" hold_for_zones="true" />
            <ShiftBuoyTarget />
            <!-- GUIDED is refused until the EKF is using the GPS again, some time after surfacing. -->
            <SetFcuMode mode="GUIDED" timeout_s="60" />
            <Timeout msec="600000">
              <RetryUntilSuccessful num_attempts="-1">
                <Fallback>
                  <NavigateSurfaceGps target_latitude="{target_latitude}" target_longitude="{target_longitude}"
                    start_latitude="{start_latitude}" start_longitude="{start_longitude}"
                    tolerance="{gps_tolerance}" keep_out_radius="{keep_out_radius}"
                    start_buoy_latitude="{start_buoy_latitude}" start_buoy_longitude="{start_buoy_longitude}"
                    end_buoy_latitude="{end_buoy_latitude}" end_buoy_longitude="{end_buoy_longitude}" />
                  <Sequence>
                    <Sleep msec="1000" />
                    <AlwaysFailure />
                  </Sequence>
                </Fallback>
              </RetryUntilSuccessful>
            </Timeout>
            <AlignHeading target_heading="{heading}" tolerance="{heading_tolerance}" />
            <SetRingRecording enable="false" />
            <SubTree ID="DiveAndAcquirePipeline" _autoremap="true" />
            <SubTree ID="SurveyPipeline" _autoremap="true" />
          </Sequence>
          <AlwaysSuccess />
        </Fallback>
        <SubTree ID="SurfaceAndReport" _autoremap="true" />
        <!-- Task 4: the report is sent, but the vehicle stays armed on the surface (keeping out of any RoboCommand zone) until
             no zone is active; with no zone this succeeds at once. -->
        <KeepClearOfZones />
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="MissionPreflight">
    <Sequence>
      <RequireMissionStarted />
      <RequireVehicleReady />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SurfaceTransitToStart">
    <Sequence>
      <!-- The run can start before the USV's PipelineBuoys message (the start point) has arrived. There is no fallback to the
           configured coordinates: stand by on the surface, with no time limit, until it does (the operator aborts to stop). -->
      <WaitForBuoyTarget />
      <!-- Waited in standby_mode (MANUAL: floats, no hold pushing the hull under); now the surface mode (no-op if the same). -->
      <SetFcuMode mode="{surface_mode}" timeout_s="60" />
      <!-- A failed navigation is retried once per second instead of failing the whole mission. The limit also has to cover
           Task 4 detours and waiting for a moving object to pass. -->
      <Timeout msec="600000">
        <RetryUntilSuccessful num_attempts="-1">
          <Fallback>
            <NavigateSurfaceGps target_latitude="{target_latitude}" target_longitude="{target_longitude}"
              start_latitude="{start_latitude}" start_longitude="{start_longitude}"
              tolerance="{gps_tolerance}" keep_out_radius="{keep_out_radius}"
                    start_buoy_latitude="{start_buoy_latitude}" start_buoy_longitude="{start_buoy_longitude}"
                    end_buoy_latitude="{end_buoy_latitude}" end_buoy_longitude="{end_buoy_longitude}" />
            <Sequence>
              <Sleep msec="1000" />
              <AlwaysFailure />
            </Sequence>
          </Fallback>
        </RetryUntilSuccessful>
      </Timeout>
      <!-- From here the UUV dives at this buoy; later USV updates no longer move the target. -->
      <LockBuoyTarget />
      <AlignHeading target_heading="{heading}" tolerance="{heading_tolerance}" />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="DiveAndAcquirePipeline">
    <Sequence>
      <!-- The GPS is lost as soon as the body is under water, and GUIDED entered or kept without it can stop
           following commands. Dive and work under water in ALT_HOLD with RC override (docs/task2_mode_experiments.md). -->
      <SetFcuMode mode="{underwater_mode}" />
      <DiveToDepth target_depth="{inspection_depth}" target_heading="{heading}"
        depth_tolerance="{depth_tolerance}" heading_tolerance="{heading_tolerance}" />
      <!-- A pass can cross the pipe at an angle and miss it; fall back to a search sweep. -->
      <RetryUntilSuccessful num_attempts="3">
        <Fallback>
          <Timeout msec="{acquire_timeout_ms}">
            <AcquirePipeline camera_name="{camera_name}" use_heading_prior="true"
              heading_prior="{heading_prior}" heading_tolerance="{heading_tolerance}" />
          </Timeout>
          <SubTree ID="ReacquirePipeline" _autoremap="true" />
        </Fallback>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <!-- After the dive (near the start buoy or midway between the buoys, facing the end buoy): back up along the pipe (stern
       toward the start buoy) to the pipe's start, then the survey forward over the whole pipe. A dive that drifted past the
       first nodes still records them. Rings are recorded only in the forward survey (not while diving or backing up). -->
  <BehaviorTree ID="SurveyPipeline">
    <Sequence name="back_up_to_the_start_then_survey">
      <StartSurveyLeg />
      <!-- The start end: the pipe out of view leg_end_lost_s in total (no search here: a lost pipe is the end). -->
      <ForceSuccess>
        <Timeout msec="{traverse_timeout_ms}">
          <KeepRunningUntilFailure>
            <WhileDoElse>
              <Inverter>
                <PipelineLegEnded lost_s="{leg_end_lost_s}" />
              </Inverter>
              <FollowPipeline enable="true" reverse="true" />
              <AlwaysFailure />
            </WhileDoElse>
          </KeepRunningUntilFailure>
        </Timeout>
      </ForceSuccess>
      <SetRingRecording enable="true" />
      <!-- The pipe's start is just ahead (the vehicle still faces the end buoy): surge forward onto it, at whatever angle
           the pipe runs (a bent pipe is off the buoy line, so no heading prior here). -->
      <RetryUntilSuccessful num_attempts="3">
        <Timeout msec="{acquire_timeout_ms}">
          <AcquirePipeline camera_name="{camera_name}" use_heading_prior="false"
            heading_prior="{heading_prior}" heading_tolerance="{heading_tolerance}" />
        </Timeout>
      </RetryUntilSuccessful>
      <SubTree ID="TraversePipeline" _autoremap="true" />
    </Sequence>
  </BehaviorTree>

  <!-- One step of a traverse: repair a pending red ring, reacquire a lost pipe, or follow. -->
  <BehaviorTree ID="TraverseStep">
    <ReactiveFallback name="traverse_reactive">
      <Sequence name="repair_red_ring">
        <RedRingPending />
        <SubTree ID="RepairRedRing" _autoremap="true" />
        <AcknowledgeRedRing />
      </Sequence>
      <Sequence name="reacquire_lost_pipeline">
        <PipelineLost />
        <!-- A failed reacquire waits before the next try: ticking FollowPipeline and SearchPipeline every 50 ms makes
             them displace each other before the goal arbiter's zero barrier lets either start (livelock). -->
        <Fallback>
          <SubTree ID="ReacquirePipeline" _autoremap="true" />
          <Sequence>
            <Sleep msec="2000" />
            <AlwaysFailure />
          </Sequence>
        </Fallback>
      </Sequence>
      <FollowPipeline enable="true" />
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Repeats repair/reacquire/follow until the pipeline ends; a failed pass or the overall
       traverse timeout ends the traversal and the trailing PipelineEnded reports a failure. -->
  <BehaviorTree ID="TraversePipeline">
    <Sequence>
      <ForceSuccess>
        <Timeout msec="{traverse_timeout_ms}">
          <KeepRunningUntilFailure>
            <WhileDoElse>
              <PipelineActive />
              <SubTree ID="TraverseStep" _autoremap="true" />
              <AlwaysFailure />
            </WhileDoElse>
          </KeepRunningUntilFailure>
        </Timeout>
      </ForceSuccess>
      <PipelineEnded />
    </Sequence>
  </BehaviorTree>

  <!-- Core: hold the probe for hold_duration. Advanced and Disruptive: the decoder window opens first and stays open
       through the whole repair, so it sees the ring red, then the steady green after the repair, then the flash
       code. Meanwhile: (1) sink onto the ring by camera until the probe holds the magnetic switch and the ring stays
       GREEN, (2) stay on the node with the ring centred while the code is read. Every step has a time limit and a failed step never fails the repair: if the code is not
       read, the report falls back to the Core survey. -->
  <BehaviorTree ID="RepairRedRing">
    <Sequence>
      <CenterOnRing ring_color="red" tolerance="{ring_tolerance}" />
      <Fallback>
        <Sequence>
          <ScriptCondition code="decode_enabled == true" />
          <ForceSuccess>
            <Parallel success_count="1" failure_count="2">
              <Sequence>
                <ForceSuccess>
                  <Timeout msec="{approach_timeout_ms}">
                    <HoldProbeOnRing hold_duration="{approach_hold_s}" alignment_tolerance="{repair_ring_tolerance}"
                      descent_rate="{approach_descent_rate}" contact_ring_size="{approach_contact_ring_size}"
                      max_descent="{approach_max_descent}" climb_back="false" />
                  </Timeout>
                </ForceSuccess>
                <HoldProbeOnRing hold_duration="{decode_window}" alignment_tolerance="{repair_ring_tolerance}" />
              </Sequence>
              <DecodeResourceCode timeout_s="{decode_total}" />
            </Parallel>
          </ForceSuccess>
          <!-- The pipe is not followable from 0.4 m above the node: climb back to where the approach started. -->
          <ForceSuccess>
            <Timeout msec="{approach_timeout_ms}">
              <HoldProbeOnRing hold_duration="{approach_hold_s}" alignment_tolerance="{repair_ring_tolerance}"
                descent_rate="{approach_descent_rate}" climb_only="true" />
            </Timeout>
          </ForceSuccess>
        </Sequence>
        <ForceSuccess>
          <Timeout msec="{approach_timeout_ms}">
            <HoldProbeOnRing hold_duration="{approach_hold_s}" alignment_tolerance="{repair_ring_tolerance}"
              descent_rate="{approach_descent_rate}" contact_ring_size="{approach_contact_ring_size}"
              max_descent="{approach_max_descent}" />
          </Timeout>
        </ForceSuccess>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ReacquirePipeline">
    <Sequence>
      <SearchPipeline camera_name="{camera_name}" use_heading_prior="true"
        heading_prior="{heading_prior}" search_span="{search_span}" sweep_rate="{sweep_rate}" />
      <Timeout msec="{acquire_timeout_ms}">
        <AcquirePipeline camera_name="{camera_name}" use_heading_prior="false"
          heading_prior="{heading_prior}" heading_tolerance="{heading_tolerance}" />
      </Timeout>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SurfaceAndReport">
    <Sequence>
      <Fallback>
        <Timeout msec="5000">
          <WaitSurveyComplete />
        </Timeout>
        <GiveUpSurvey />
      </Fallback>
      <Surface target_depth="{surface_depth}" depth_tolerance="{surface_tolerance}" hold_for_zones="true" />
      <ConfirmSurfaceAction />
      <Fallback>
        <Timeout msec="5000">
          <PublishPipelineSurvey />
        </Timeout>
        <Timeout msec="5000">
          <PublishPipelineSurvey best_effort="true" />
        </Timeout>
      </Fallback>
    </Sequence>
  </BehaviorTree>
</root>
