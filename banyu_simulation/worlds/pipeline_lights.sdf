<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="pipeline_lights">
    <!-- Simulation Physics System -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    
    <!-- Sensor System (Camera, Magnetometer, etc.) -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    
    <!-- Magnetometer System Plugin -->
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    
    <!-- Scene Broadcaster (Required for GUI & Visual Updates) -->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    
    <!-- User Commands System (Enables moving models in GUI) -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- Ambient Lighting (Authentic Underwater Pipeline Lighting Atmosphere) -->
    <scene>
      <ambient>0.08 0.12 0.16 1.0</ambient>
      <background>0.03 0.06 0.10 1.0</background>
      <grid>true</grid>
    </scene>

    <!-- Overhead Soft Directional Light (Attenuated aquatic sunlight) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.25 0.28 0.32 1.0</diffuse>
      <specular>0.15 0.18 0.20 1.0</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1.0</ambient>
            <diffuse>0.3 0.3 0.35 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- RobotX Underwater Pipeline Structure (3" PVC Pipe with 3 Base Assemblies) -->
    <include>
      <name>pipeline_robotx</name>
      <uri>model://pipeline_robotx</uri>
      <pose>0.0 0.0 0.0 0 0 0</pose>
    </include>

    <!-- Node 1: Segment 1 Lead-in (X = 0.0 m, Y = -0.05 m, Z = 1.596 m, Yaw = 1.571 rad) -->
    <include>
      <name>light_node_1</name>
      <uri>model://robotx_light_node</uri>
      <pose>0.0 -0.05 1.596 0 0 1.5708</pose>
    </include>

    <!-- Node 2: Segment 2 Transition Dogleg (X = -0.62 m, Y = 1.369 m, Z = 1.596 m, Yaw = 2.356 rad) -->
    <include>
      <name>light_node_2</name>
      <uri>model://robotx_light_node</uri>
      <pose>-0.62 1.369 1.596 0 0 2.3562</pose>
    </include>

    <!-- Node 3: Segment 4 Return Dogleg (X = -0.62 m, Y = 2.645 m, Z = 1.596 m, Yaw = 0.785 rad, mirroring Node 2) -->
    <include>
      <name>light_node_3</name>
      <uri>model://robotx_light_node</uri>
      <pose>-0.62 2.645 1.596 0 0 0.7854</pose>
    </include>

    <!-- Node 4: Segment 5 Cantilever Lead-out (X = 0.0 m, Y = 4.05 m, Z = 1.596 m, Yaw = 1.571 rad) -->
    <include>
      <name>light_node_4</name>
      <uri>model://robotx_light_node</uri>
      <pose>0.0 4.05 1.596 0 0 1.5708</pose>
    </include>

    <!-- Overview Inspection Camera (Captures entire pipeline & all 4 light nodes) -->
    <model name="inspection_camera">
      <static>true</static>
      <pose>2.8 -1.8 3.2 0.0 0.3406 2.2928</pose>
      <link name="camera_link">
        <sensor name="pipeline_cam" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image>
              <width>1920</width>
              <height>1080</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>50.0</far>
            </clip>
          </camera>
          <visualize>true</visualize>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
