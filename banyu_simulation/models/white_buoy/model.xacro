<?xml version="1.0"?>
<robot name="white_buoy" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name=" link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <mass value="5000" />
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
    </inertial>

    <visual>
      <origin />
      <geometry>
        <mesh filename=" package://white_buoy/meshes/white_buoy.dae" />
      </geometry>
    </visual>
    <collision name="collision_inner">
      <origin xyz=" 0 0 0.3637" />
      <geometry>
        <cylinder radius=" 0.15" length=" 1.26" />
      </geometry>
    </collision>
    <collision name="collision_outer">
      <origin xyz=" 0 0 -0.1117" />
      <geometry>
        <cylinder radius=" 0.24" length=" 0.15" />
      </geometry>
    </collision>
  </link>
  <gazebo>
    <static>true</static>
  </gazebo>
</robot>