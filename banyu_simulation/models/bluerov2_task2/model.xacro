<?xml version="1.0"?>
<robot name="bluerov2_heavy" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="probe" default="true" />
  <xacro:include filename="$(find bluerov2_gz)/models/bluerov2_heavy/model.xacro" />

  <!-- Task 2: 4 Hydrophone frames for pinger localization TDOA -->
  <link name="hydrophone_1" />
  <link name="hydrophone_2" />
  <link name="hydrophone_3" />
  <link name="hydrophone_4" />

  <joint name="hydrophone_1_joint" type="fixed">
    <parent link="base_link" />
    <child link="hydrophone_1" />
    <origin xyz="0.15 0 -0.10" rpy="0 0 0" />
  </joint>
  <joint name="hydrophone_2_joint" type="fixed">
    <parent link="base_link" />
    <child link="hydrophone_2" />
    <origin xyz="-0.15 0 -0.10" rpy="0 0 0" />
  </joint>
  <joint name="hydrophone_3_joint" type="fixed">
    <parent link="base_link" />
    <child link="hydrophone_3" />
    <origin xyz="0 0.15 -0.10" rpy="0 0 0" />
  </joint>
  <joint name="hydrophone_4_joint" type="fixed">
    <parent link="base_link" />
    <child link="hydrophone_4" />
    <origin xyz="0 -0.15 -0.10" rpy="0 0 0" />
  </joint>

  <!-- Down-facing echosounder (LaserScan on /down_sonar/scan) -->
  <link name="down_sonar_link">
    <inertial>
      <mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>
  <joint name="down_sonar_joint" type="fixed">
    <parent link="base_link" />
    <child link="down_sonar_link" />
    <origin xyz="0 0 -0.10" rpy="0 1.57079632679 0" />
  </joint>

  <gazebo reference="down_sonar_link">
    <sensor name="down_sonar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>/down_sonar/scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.15</min_angle>
            <max_angle>0.15</max_angle>
          </horizontal>
          <vertical>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.15</min_angle>
            <max_angle>0.15</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>35.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Task 2 Bow Magnetic Repair Probe -->
  <xacro:if value="$(arg probe)">
    <link name="probe_link">
      <visual>
        <origin xyz="0 0 -0.20" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.006" length="0.40" />
        </geometry>
        <material name="probe_black">
          <color rgba="0.1 0.1 0.1 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.20" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.006" length="0.40" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05" />
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-5" />
      </inertial>
    </link>
    <joint name="probe_joint" type="fixed">
      <parent link="base_link" />
      <child link="probe_link" />
      <origin xyz="0.27 0 0.14" rpy="0 0 0" />
    </joint>
    <!-- Probe tip datum link (magnetic contact point at bottom of 0.40m rod) -->
    <link name="probe_tip" />
    <joint name="probe_tip_joint" type="fixed">
      <parent link="probe_link" />
      <child link="probe_tip" />
      <origin xyz="0 0 -0.40" rpy="0 0 0" />
    </joint>
  </xacro:if>

  <!-- HydrophoneArray plugin: listens to pinger_green, computes TDOA and publishes arrivals -->
  <gazebo>
    <plugin filename="BanyuHydrophoneArray" name="banyu::HydrophoneArray">
      <pinger_model>pinger_green</pinger_model>
      <acoustic_offset>0 0 -0.186</acoustic_offset>
      <hydrophone>0.15 0 -0.1</hydrophone>
      <hydrophone>-0.15 0 -0.1</hydrophone>
      <hydrophone>0 0.15 -0.1</hydrophone>
      <hydrophone>0 -0.15 -0.1</hydrophone>
      <ping_rate>1.0</ping_rate>
      <jitter>2e-6</jitter>
      <blocker>-0.15 -0.057 0.003 0.19 0.057 0.117</blocker>
      <shadow_pick_delay>30e-6</shadow_pick_delay>
      <topic>/banyu/pinger/arrivals</topic>
    </plugin>
  </gazebo>
</robot>
