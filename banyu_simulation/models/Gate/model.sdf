<?xml version="1.0"?>
<sdf version="1.4">
  <model name="gate">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <collision name="right_collision">
        <pose>0 -1.0 -2.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.08 2.0</size>
          </box>
        </geometry>
      </collision>

      <collision name="left_collision">
        <pose>0 1.0 -2.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 0.08 2.0</size>
          </box>
        </geometry>
      </collision>

      <collision name="top_collision">
        <pose>0 0 -1.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 2.08 0.2</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 -3.1 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://Gate/meshes/gate.dae</uri>
            <scale>1 0.4 0.5</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.15 0.13 0 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://Gate/materials/textures/gate.png</albedo_map>
              <metalness>0</metalness>
              <roughness>0.6</roughness>
            </metal>
          </pbr>
        </material>
