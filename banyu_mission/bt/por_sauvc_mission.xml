<?xml version="1.0" encoding="UTF-8"?>
<!-- SAUVC submission video mission (mission.use_sauvc):
     dive to depth -> settle -> move forward -> pause -> turn around 180 deg ->
     pause -> move forward back to start -> hover -> surface -> disarm (on SUCCESS).
     Uses TimedMove in ALT_HOLD + RC override (Bar30 depth hold, IMU yaw cap + heading hold).
     Any settle/pause/hover duration set to 0.0 is skipped immediately. -->
<root BTCPP_format="4" main_tree_to_execute="Main">
  <BehaviorTree ID="Main">
    <ReactiveFallback name="por_sauvc_mission_root">
      <Sequence name="interrupt_sequence">
        <AutonomyInterrupted />
        <HandleAbortOrTeleop />
      </Sequence>
      <Sequence name="por_sauvc_mission_phases">
        <Sequence name="mission_preflight">
          <RequireMissionStarted />
          <ArmAndSetGuided />
        </Sequence>
        <!-- 1. Dive to target depth (Bar30 check_depth_reached stops early once inside tolerance) -->
        <TimedMove name="dive" segment_name="dive"
          duration_s="{sauvc_dive_duration_s}"
          speed_x_mps="0.0" speed_y_mps="0.0"
          speed_z_mps="{sauvc_dive_speed_z_mps}" yaw_rate_rad_s="0.0"
          use_baro_depth="{use_baro_depth}" target_depth_m="{sauvc_depth_m}"
          check_depth_reached="{use_sensors}" depth_tolerance_m="{sauvc_depth_tolerance_m}"
          depth_kp="{depth_kp}" max_depth_speed_mps="{max_depth_speed_mps}"
          use_imu_yaw_cap="false" target_yaw_delta_rad="0.0"
          enable_collision_guard="false" collision_distance_m="{collision_distance_m}" />
        <!-- Optional settle at depth before driving forward -->
        <TimedMove name="settle_after_dive" segment_name="settle_after_dive"
          duration_s="{sauvc_settle_duration_s}"
          speed_x_mps="0.0" speed_y_mps="0.0"
          speed_z_mps="0.0" yaw_rate_rad_s="0.0"
          use_baro_depth="{use_baro_depth}" target_depth_m="{sauvc_depth_m}"
          depth_kp="{depth_kp}" max_depth_speed_mps="{max_depth_speed_mps}"
          use_imu_yaw_cap="false" target_yaw_delta_rad="0.0"
          enable_collision_guard="false" collision_distance_m="{collision_distance_m}" />
        <!-- 2. Move forward for a set time (heading_hold keeps initial heading) -->
        <TimedMove name="forward_out" segment_name="forward_out"
          duration_s="{sauvc_forward_duration_s}"
          speed_x_mps="{sauvc_forward_speed_x_mps}" speed_y_mps="0.0"
          speed_z_mps="0.0" yaw_rate_rad_s="0.0"
          use_baro_depth="{use_baro_depth}" target_depth_m="{sauvc_depth_m}"
          depth_kp="{depth_kp}" max_depth_speed_mps="{max_depth_speed_mps}"
          use_imu_yaw_cap="false" target_yaw_delta_rad="0.0"
          enable_collision_guard="{enable_collision_guard}" collision_distance_m="{collision_distance_m}" />
        <!-- Optional coast/pause before turning -->
        <TimedMove name="coast_after_forward" segment_name="coast_after_forward"
          duration_s="{sauvc_coast_duration_s}"
          speed_x_mps="0.0" speed_y_mps="0.0"
          speed_z_mps="0.0" yaw_rate_rad_s="0.0"
          use_baro_depth="{use_baro_depth}" target_depth_m="{sauvc_depth_m}"
          depth_kp="{depth_kp}" max_depth_speed_mps="{max_depth_speed_mps}"
          use_imu_yaw_cap="false" target_yaw_delta_rad="0.0"
          enable_collision_guard="false" collision_distance_m="{collision_distance_m}" />
        <!-- 3. Turn around 180 deg in place (IMU yaw cap stops at target_yaw_delta_rad) -->
        <TimedMove name="turn_around_180" segment_name="turn_around_180"
          duration_s="{sauvc_turn_duration_s}"
          speed_x_mps="0.0" speed_y_mps="0.0"
          speed_z_mps="0.0" yaw_rate_rad_s="{sauvc_turn_yaw_rate_rad_s}"
          use_baro_depth="{use_baro_depth}" target_depth_m="{sauvc_depth_m}"
          depth_kp="{depth_kp}" max_depth_speed_mps="{max_depth_speed_mps}"
          use_imu_yaw_cap="{use_imu_yaw_cap}" target_yaw_delta_rad="{sauvc_turn_target_angle_rad}"
          enable_collision_guard="false" collision_distance_m="{collision_distance_m}" />
        <!-- Optional settle after turning before returning -->
        <TimedMove name="settle_after_turn" segment_name="settle_after_turn"
          duration_s="{sauvc_coast_duration_s}"
          speed_x_mps="0.0" speed_y_mps="0.0"
          speed_z_mps="0.0" yaw_rate_rad_s="0.0"
          use_baro_depth="{use_baro_depth}" target_depth_m="{sauvc_depth_m}"
          depth_kp="{depth_kp}" max_depth_speed_mps="{max_depth_speed_mps}"
          use_imu_yaw_cap="false" target_yaw_delta_rad="0.0"
          enable_collision_guard="false" collision_distance_m="{collision_distance_m}" />
        <!-- 4. Move forward for a set time returning to start (heading_hold keeps post-turn heading) -->
        <TimedMove name="forward_return" segment_name="forward_return"
          duration_s="{sauvc_return_duration_s}"
          speed_x_mps="{sauvc_return_speed_x_mps}" speed_y_mps="0.0"
          speed_z_mps="0.0" yaw_rate_rad_s="0.0"
          use_baro_depth="{use_baro_depth}" target_depth_m="{sauvc_depth_m}"
          depth_kp="{depth_kp}" max_depth_speed_mps="{max_depth_speed_mps}"
          use_imu_yaw_cap="false" target_yaw_delta_rad="0.0"
          enable_collision_guard="{enable_collision_guard}" collision_distance_m="{collision_distance_m}" />
        <!-- Optional hover at start before surfacing -->
        <TimedMove name="hover_before_surface" segment_name="hover_before_surface"
          duration_s="{sauvc_hover_duration_s}"
          speed_x_mps="0.0" speed_y_mps="0.0"
          speed_z_mps="0.0" yaw_rate_rad_s="0.0"
          use_baro_depth="{use_baro_depth}" target_depth_m="{sauvc_depth_m}"
          depth_kp="{depth_kp}" max_depth_speed_mps="{max_depth_speed_mps}"
          use_imu_yaw_cap="false" target_yaw_delta_rad="0.0"
          enable_collision_guard="false" collision_distance_m="{collision_distance_m}" />
        <!-- 5. Surface (Bar30 check_depth_reached stops once near surface_depth_m; BanyuMission disarms on SUCCESS) -->
        <TimedMove name="surface" segment_name="surface"
          duration_s="{timed_surface_duration_s}"
          speed_x_mps="{timed_surface_speed_x_mps}" speed_y_mps="{timed_surface_speed_y_mps}"
          speed_z_mps="{timed_surface_speed_z_mps}" yaw_rate_rad_s="{timed_surface_yaw_rate_rad_s}"
          use_baro_depth="{use_baro_depth}" target_depth_m="{surface_depth_m}"
          check_depth_reached="{use_sensors}" depth_tolerance_m="{surface_tolerance_m}"
          depth_kp="{depth_kp}" max_depth_speed_mps="{max_depth_speed_mps}"
          use_imu_yaw_cap="false" target_yaw_delta_rad="0.0"
          enable_collision_guard="false" collision_distance_m="{collision_distance_m}" />
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>
</root>
