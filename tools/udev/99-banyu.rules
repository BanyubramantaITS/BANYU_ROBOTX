# BANYU AUV persistent device names (install: see docs/udev_rules.md).
# ID_MM_DEVICE_IGNORE keeps ModemManager from probing the serial devices with AT commands.

# Pixhawk 1 (ArduSub), MAVProxy master
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="5741", SYMLINK+="pixhawk", MODE="0666", GROUP="dialout", ENV{ID_MM_DEVICE_IGNORE}="1"

# u-blox RTK GNSS receiver, read by gps_to_pixhawk.py (tools/scripts/run_gps_bridge.sh)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", SYMLINK+="gps_rtk", MODE="0666", GROUP="dialout", ENV{ID_MM_DEVICE_IGNORE}="1"

# ESP32 kill-switch indicator (native USB Serial/JTAG; generic Espressif ID, so keep only one ESP32 plugged in)
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", SYMLINK+="esp32_kill", MODE="0666", GROUP="dialout", ENV{ID_MM_DEVICE_IGNORE}="1"

# Front camera: "H264 USB Camera" (Task 2 YOLO collision avoidance); index 0 is the capture node
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="32e4", ATTRS{idProduct}=="9422", ATTR{index}=="0", SYMLINK+="front_camera", MODE="0666", GROUP="video"

# Bottom camera: Horus B "2M WebCam" (Task 2); index 0 is the capture node
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="2ce3", ATTRS{idProduct}=="3894", ATTR{index}=="0", SYMLINK+="bottom_camera", MODE="0666", GROUP="video"
