<?xml version="1.0"?>
<sdf version="1.11">
    <world name="ocean">
        <!-- Base Gazebo plugins -->
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
        </plugin>
        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
        </plugin>

        <!-- DVL plugin manages all DVL sensors. MUST be world-level: declaring
             it inside a model is silently ignored (no error, no topic). -->
        <plugin filename="gz-sim-dvl-system"
            name="gz::sim::systems::DopplerVelocityLogSystem">
        </plugin>

        <!-- IMU plugin manages all IMU sensors -->
        <plugin filename="libgz-sim-imu-system.so"
            name="gz::sim::systems::Imu">
        </plugin>

        <!-- Magnetometer plugin manages all magnetometer sensors -->
        <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer">
        </plugin>

        <!-- Spherical coordinates for Earth magnetic field reference (ArduSub SITL datum) -->
        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <latitude_deg>-35.363262</latitude_deg>
            <longitude_deg>149.165237</longitude_deg>
            <elevation>0.0</elevation>
            <heading_deg>0.0</heading_deg>
        </spherical_coordinates>

        <!-- Buoyancy plugin manages buoyancy for all models -->
        <plugin
            filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
            <!-- Fluid density is 1 (air) above 0 and 1000 (water) below 0 -->
            <graded_buoyancy>
                <default_density>1000</default_density>
                <density_change>
                    <above_depth>0</above_depth>
                    <density>1</density>
                </density_change>
            </graded_buoyancy>
            <!-- Enable by model name -->
            <enable>bluerov2_heavy</enable>
        </plugin>

        <!-- Light as it arrives at the pipeline (~15 m), not surface sunlight.
             Each channel is 0.8 * exp(-downwelling * 15), downwelling from the
             UnderwaterTurbidity plugin below; recompute both if either changes.
             Turbid water scatters light into a diffuse glow, so no shadows and
             the ambient term carries as much as the direct one. Emissive LEDs
             are unaffected.
             ponytail: uniform, not per-depth. Surface props (buoy indicators)
             come out as dark as the pipeline, and the GUI 3D view goes dark
             too. Per-pixel depth dimming in the turbidity shader is the
             upgrade, once it can tell emissive surfaces apart. -->
        <scene>
            <ambient>0.0005 0.019 0.001 1</ambient>
            <background>0.0005 0.019 0.001 1</background>
            <shadows>false</shadows>
        </scene>
        <light type="directional" name="downwelling">
            <cast_shadows>false</cast_shadows>
            <diffuse>0.0005 0.019 0.001 1</diffuse>
            <specular>0 0 0 1</specular>
            <direction>0 0 -1</direction>
        </light>

        <!-- Seabed. NOT sand_heightmap: that model is a 5 m x 5 m patch (its
             mesh spans +/-5 m and is scaled 0.5), which left the Task 2
             pipeline at x~51 hanging over empty space with no bottom beneath
             it. No bottom means the DVL never gets bottom lock, so EKF3's SRC2
             source set has nothing aiding it anywhere on this course.
             A plane covers the whole course instead.
             ponytail: flat and untextured. The seabed is not a detection
             target; it exists to give the DVL something to range against and
             the camera a horizon. Swap in a textured mesh if the camera ever
             needs realistic ground. -->
        <model name="seabed">
            <static>true</static>
            <pose>0 0 -15 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>50 50</size>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>50 50</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.62 0.56 0.42 1</ambient>
                        <diffuse>0.62 0.56 0.42 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- RobotX 2026 Task 2 course.
             Pipeline structure: 3" Schedule 40 PVC competition pipeline (pipeline_robotx).
             Nodes 1-4: Competition optical light nodes with 4-layer optical stack and magnetometer. -->
        <include>
            <name>pipeline</name>
            <uri>model://pipeline_robotx</uri>
            <pose>2.3 0 -15 0 0 3.14159265</pose>
        </include>

        <!-- 4 competition light nodes placed along the pipeline segments -->
        <include>
            <name>light_node_1</name>
            <uri>model://robotx_light_node</uri>
            <pose relative_to="pipeline">-0.05 0.0 1.596 0 0 0.0</pose>
        </include>
        <include>
            <name>light_node_2</name>
            <uri>model://robotx_light_node</uri>
            <pose relative_to="pipeline">1.369 0.62 1.596 0 0 0.7854</pose>
        </include>
        <include>
            <name>light_node_3</name>
            <uri>model://robotx_light_node</uri>
            <pose relative_to="pipeline">2.645 0.62 1.596 0 0 -0.7854</pose>
        </include>
        <include>
            <name>light_node_4</name>
            <uri>model://robotx_light_node</uri>
            <pose relative_to="pipeline">4.05 0.0 1.596 0 0 0.0</pose>
        </include>

        <!-- "Two buoys will be placed near the ends of the pipeline" (p.64).
             Laid out like the handbook's Task 2 figure: each buoy ~1.5 m
             (about a third of the pipe length) past its end, on the pipe
             axis. GREEN = active buoy, survey start. -->
        <include>
            <name>robobuoy_green</name>
            <uri>model://robotx_robobuoy</uri>
            <pose>3.8 0 0 0 0 0</pose>
        </include>
        <include>
            <name>indicator_green</name>
            <uri>model://robotx_color_indicator_green</uri>
            <pose relative_to="robobuoy_green::indicator_mount"/>
        </include>
        <include>
            <name>pinger_green</name>
            <uri>model://robotx_pinger</uri>
            <pose relative_to="robobuoy_green::anchor_point"/>
        </include>

        <include>
            <name>robobuoy_red</name>
            <uri>model://robotx_robobuoy</uri>
            <pose>-3.8 0 0 0 0 0</pose>
        </include>
        <include>
            <name>indicator_red</name>
            <uri>model://robotx_color_indicator_red</uri>
            <pose relative_to="robobuoy_red::indicator_mount"/>
        </include>
        <!-- Silent: HydrophoneArray only pings its <pinger_model> (pinger_green). -->
        <include>
            <name>pinger_red</name>
            <uri>model://robotx_pinger</uri>
            <pose relative_to="robobuoy_red::anchor_point"/>
        </include>

        <!-- DVL -> ArduSub SITL (VISION_POSITION_DELTA). Pairs with
             sim_vehicle.py -\-out=udp:127.0.0.1:14552 in sitl_mavros.launch.py. -->
        <plugin filename="BanyuDvlMavlink" name="banyu::DvlMavlink"/>

        <plugin filename="BanyuUnderwaterTurbidity" name="banyu::UnderwaterTurbidity">
            <camera>front_camera</camera>
            <camera>bottom_camera</camera>
            <surface_z>0</surface_z>
            <!-- Tuned to Marina Bay (turbid, green-olive reservoir water, photo
                 2026-09-21). Colour is matched to the photo; visibility is a guess. -->
            <!-- Per-channel beam attenuation (1/m, RGB). Green carries furthest. -->
            <attenuation>0.60 0.35 0.55</attenuation>
            <!-- Veiling light colour at infinite range, just below the surface. -->
            <backscatter>0.10 0.14 0.09</backscatter>
            <!-- Downwelling attenuation (1/m): darkens the veil with camera depth. -->
            <downwelling>0.50 0.25 0.45</downwelling>
        </plugin>

    </world>
</sdf>