<root BTCPP_format="4" main_tree_to_execute="BanyuMission">
  <BehaviorTree ID="BanyuMission">
    <ReactiveFallback name="MissionSupervisor">
      <AbortedOrTeleop name="IdleOrAborted" />
      <Sequence name="MissionFlow">
        <MissionActive name="MissionRunning" />
        <NavToGate name="NavToGate" />
        <GateAlign name="GateAlign" />
        <GatePass name="GatePass" />
        <SearchMarker name="SearchMarker" />
        <MarkerAlign name="MarkerAlign" />
        <MarkerOrbit name="MarkerOrbit" />
        <!-- Return leg: turn around, find the gate behind the buoy, align,
             drive back through it, then surface at the start side. -->
        <Sequence name="ReturnToStart">
          <TurnAround name="TurnAround" />
          <SearchGate name="SearchGate" />
          <GateAlign name="ReturnGateAlign" />
          <ReturnGatePass name="ReturnGatePass" />
          <Surface name="Surface" />
        </Sequence>
        <ModeStabilize name="ModeStabilize" />
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>
</root>