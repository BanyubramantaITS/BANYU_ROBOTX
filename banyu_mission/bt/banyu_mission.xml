<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="Main">
  <BehaviorTree ID="Main">
    <ReactiveFallback name="mission_root">
      <Sequence name="interrupt_sequence">
        <AutonomyInterrupted />
        <HandleAbortOrTeleop />
      </Sequence>
      <Sequence name="mission_phases">
        <SubTree ID="MissionPreflight" _autoremap="true" />
        <SubTree ID="SurfaceTransitToStart" _autoremap="true" />
        <SubTree ID="DiveAndAcquirePipeline" _autoremap="true" />
        <SubTree ID="TraversePipeline" _autoremap="true" />
        <SubTree ID="SurfaceAndReport" _autoremap="true" />
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="MissionPreflight">
    <Sequence>
      <RequireMissionStarted />
      <RequireVehicleReady />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SurfaceTransitToStart">
    <Sequence>
      <NavigateSurfaceGps target_latitude="{target_latitude}" target_longitude="{target_longitude}"
        start_latitude="{start_latitude}" start_longitude="{start_longitude}"
        tolerance="{gps_tolerance}" />
      <!-- From here the UUV dives at this buoy; later USV updates no longer move the target. -->
      <LockBuoyTarget />
      <AlignHeading target_heading="{heading}" tolerance="{heading_tolerance}" />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="DiveAndAcquirePipeline">
    <Sequence>
      <!-- The GPS is lost as soon as the body is under water, and GUIDED entered or kept without it can stop
           following commands. Dive and work under water in ALT_HOLD with RC override (docs/task2_mode_experiments.md). -->
      <SetFcuMode mode="{underwater_mode}" />
      <DiveToDepth target_depth="{inspection_depth}" target_heading="{heading}"
        depth_tolerance="{depth_tolerance}" heading_tolerance="{heading_tolerance}" />
      <!-- A pass can cross the pipe at an angle and miss it; fall back to a search sweep. -->
      <RetryUntilSuccessful num_attempts="3">
        <Fallback>
          <Timeout msec="{acquire_timeout_ms}">
            <AcquirePipeline camera_name="{camera_name}" use_heading_prior="true"
              heading_prior="{heading_prior}" heading_tolerance="{heading_tolerance}" />
          </Timeout>
          <SubTree ID="ReacquirePipeline" _autoremap="true" />
        </Fallback>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <!-- Repeats repair/reacquire/follow until the pipeline ends; a failed pass or the overall
       traverse timeout ends the traversal and the trailing PipelineEnded reports a failure. -->
  <BehaviorTree ID="TraversePipeline">
    <Sequence>
      <ForceSuccess>
        <Timeout msec="{traverse_timeout_ms}">
          <KeepRunningUntilFailure>
            <WhileDoElse>
              <PipelineActive />
              <ReactiveFallback name="traverse_reactive">
                <Sequence name="repair_red_ring">
                  <RedRingPending />
                  <SubTree ID="RepairRedRing" _autoremap="true" />
                  <AcknowledgeRedRing />
                </Sequence>
                <Sequence name="reacquire_lost_pipeline">
                  <PipelineLost />
                  <SubTree ID="ReacquirePipeline" _autoremap="true" />
                </Sequence>
                <FollowPipeline enable="true" />
              </ReactiveFallback>
              <AlwaysFailure />
            </WhileDoElse>
          </KeepRunningUntilFailure>
        </Timeout>
      </ForceSuccess>
      <PipelineEnded />
    </Sequence>
  </BehaviorTree>

  <!-- Core: hold the probe for hold_duration. Advanced and Disruptive: (1) go down to repair_depth where the probe
       tip reaches the magnetic switch and hold it, (2) climb back to the inspection depth, where the detector
       can see the ring, and keep station there while the flash code is read. Every step has a time limit and a
       failed step never fails the repair: the survey report is still sent. -->
  <BehaviorTree ID="RepairRedRing">
    <Sequence>
      <CenterOnRing ring_color="red" tolerance="{ring_tolerance}" />
      <Fallback>
        <Sequence>
          <ScriptCondition code="decode_enabled == true" />
          <ForceSuccess>
            <Timeout msec="{repair_step_timeout_ms}">
              <Sequence>
                <DiveToDepth target_depth="{repair_depth}" target_heading="{heading}"
                  depth_tolerance="{depth_tolerance}" heading_tolerance="{heading_tolerance}" />
                <CenterOnRing ring_color="red" tolerance="{repair_ring_tolerance}" />
                <HoldProbeOnRing hold_duration="{hold_duration}" alignment_tolerance="{repair_ring_tolerance}" />
              </Sequence>
            </Timeout>
          </ForceSuccess>
          <ForceSuccess>
            <Timeout msec="{repair_step_timeout_ms}">
              <DiveToDepth target_depth="{inspection_depth}" target_heading="{heading}"
                depth_tolerance="{depth_tolerance}" heading_tolerance="{heading_tolerance}" />
            </Timeout>
          </ForceSuccess>
          <ForceSuccess>
            <Parallel success_count="1" failure_count="2">
              <HoldProbeOnRing hold_duration="{decode_window}" alignment_tolerance="{repair_ring_tolerance}" />
              <DecodeResourceCode timeout_s="{decode_window}" />
            </Parallel>
          </ForceSuccess>
        </Sequence>
        <HoldProbeOnRing hold_duration="{hold_duration}" alignment_tolerance="{ring_tolerance}" />
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ReacquirePipeline">
    <Sequence>
      <SearchPipeline camera_name="{camera_name}" use_heading_prior="true"
        heading_prior="{heading_prior}" search_span="{search_span}" sweep_rate="{sweep_rate}" />
      <Timeout msec="{acquire_timeout_ms}">
        <AcquirePipeline camera_name="{camera_name}" use_heading_prior="false"
          heading_prior="{heading_prior}" heading_tolerance="{heading_tolerance}" />
      </Timeout>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SurfaceAndReport">
    <Sequence>
      <Timeout msec="5000">
        <WaitSurveyComplete />
      </Timeout>
      <Surface target_depth="{surface_depth}" depth_tolerance="{surface_tolerance}" />
      <ConfirmSurfaceAction />
      <Timeout msec="5000">
        <PublishPipelineSurvey />
      </Timeout>
    </Sequence>
  </BehaviorTree>
</root>
